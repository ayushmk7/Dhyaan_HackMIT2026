# Copy to .env and fill in — Expo only inlines vars prefixed EXPO_PUBLIC_.
#
# false = talk to the real FastAPI backend; true (or unset) = in-memory mocks.
EXPO_PUBLIC_USE_MOCKS=false

# A physical phone cannot reach `localhost` (that's the phone itself) — use
# your Mac's LAN IP instead. Run `make ip` in backend/ to print it.
# Simulator/emulator on the same Mac can keep localhost.
EXPO_PUBLIC_API_BASE=http://192.168.1.23:8000/v1

# Must match backend/.env's API_KEY (defaults to this value in both places).
EXPO_PUBLIC_API_KEY=dev-key-change-me
