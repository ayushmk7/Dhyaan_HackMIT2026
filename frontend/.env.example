# Copy to .env or export inline before `npx expo start` (Expo inlines
# EXPO_PUBLIC_* at build time — see src/lib/config.ts for the full story).

# false = talk to the real backend; true = mock data, no backend needed.
# Default (unset) is now false — the app talks to a live backend out of the
# box. Set EXPO_PUBLIC_USE_MOCKS=true to demo with no backend running.
EXPO_PUBLIC_USE_MOCKS=false

# The backend's LAN address, with the /v1 prefix. Unset: http://localhost:8000/v1,
# which only works in the iOS Simulator — a real phone can't resolve
# "localhost" to your Mac. Run `cd backend && make ip` for the value to put here.
EXPO_PUBLIC_API_BASE=http://<your-mac-lan-ip>:8000/v1

# There is no API key and no login: the backend has no auth at all (see the
# notice at the top of backend/app/main.py). Demo build, one LAN.

# Skips onboarding on launch and opens the family app with the seed's resident
# (src/app/index.tsx). Unset: onboarding as normal.
EXPO_PUBLIC_DEV_SKIP_ONBOARDING=false

# Client-side Claude key, demo-only, used by src/lib/ai.ts. Unset: that
# connection-layer feature is disabled; the rest of the app is unaffected.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-5-mini
