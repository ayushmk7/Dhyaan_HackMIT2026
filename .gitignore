.venv-voice/
__pycache__/
.pytest_cache/
.env
beacons/build-*/

# Model weights and benchmark artifacts. (The standalone bench that produced
# the food and latency numbers was removed; it is in git history at 56e2237.)
# SOURCE is worth keeping (it is the evidence behind the detector choice), but
# its venv, downloaded weights and sample frames are 1.5 GB of things that
# re-download. Same for the CLIP weights the vision lane pulls.
weights/

# Ultralytics auto-downloads these by name on first run; never commit a weight.
*.pt
# The launch-video source is kept (brag-output/composition/); renders are not.
brag-output*/**/node_modules/
brag-output*/**/renders/
brag-output*/*.mp4

# The AirDropped handoff kit from a teammate; it holds two secret env files
# (root.env and frontend.env) that the bare `.env` rule above does not catch.
dhyaan-ayush-kit/
