# Copy to .env. `dev.sh` and `backend/Makefile` work with none of these set —
# every var below has a working default for a local demo. Fill in only what
# the slice you're touching needs.

# --- backend/app (backend/app/config.py) -------------------------------------

# Mongo connection. Unset: connects to the docker container `dev.sh`/`make mongo`
# starts on localhost:27017, database "dhyaan".
MONGO_URL=mongodb://localhost:27017
MONGO_DB=dhyaan

# There are no API keys. The backend has no authentication of any kind (see
# the notice at the top of backend/app/config.py's neighbour, app/main.py).
# Demo build, one LAN. An `X-Band-Key` header sent by older band or vision
# builds is ignored, not checked.

# OpenAI key for the daily narrative, chat/RAG answers and alert digests
# (backend/app/llm.py). Unset: /v1/chat/ask falls back to the local Ollama
# model below (if CHAT_FALLBACK_MODEL is set) or a template answer stitched
# from the retrieved sentences — the app still runs, just dumber.
OPENAI_API_KEY=

# Base URL the backend puts in links it hands back to itself (e.g. camera
# snapshot URLs). Unset: http://localhost:8000, which is wrong once a phone
# or cloudflared tunnel is involved — set it to your LAN IP or tunnel host.
PUBLIC_BASE_URL=http://localhost:8000

# Escalation ladder timings, seconds (TECHNICAL_PRD §4.2). Unset: 30/60/300,
# which is realistic but slow to demo — the vision worker's --demo flag and
# backend/app/presence.py's DEMO_FAST below are the usual way to speed this up
# instead of touching these.
CANCEL_WINDOW_S=30
CONTACT_WAIT_S=60
EXHAUSTED_AFTER_S=300

# Compresses presence-sweep timing 10x for on-stage demos (app/presence.py,
# app/routers/camera.py). Unset or "0"/"false": normal speed.
DEMO_FAST=

# --- backend/app/rag.py (semantic recall over the event log) -----------------

# Ollama host for embeddings (and the optional chat fallback below). Unset:
# http://localhost:11434, which is what `ollama serve` binds to by default.
OLLAMA_URL=http://localhost:11434
# Embedding model, pulled once by `make embedder`. Unset: nomic-embed-text.
EMBED_MODEL=nomic-embed-text
EMBED_TIMEOUT_S=20

# Local model for Ask when OPENAI_API_KEY is unset. Empty here on purpose:
# the test suite relies on the fallback staying off so it runs offline.
#
# dev.sh defaults it to qwen2.5vl:3b. That is the same vision model the camera
# lane already pulled and keeps warm, it answers text-only fine (measured:
# "Yes, she has eaten today. She had dinner at the table around 7:10 pm..."),
# and it costs no extra download. An earlier note here said the 3b model was
# not a substitute for qwen3-vl:8b — that was written before the camera lane
# moved to the 3b, and it is wrong.
#
# Unset with no OpenAI key, Ask still answers: rag.py stitches the retrieved
# sentences together, grouped and labelled by kind. Correct, just not prose.
CHAT_FALLBACK_MODEL=
CHAT_TIMEOUT_S=25

# --- backend/vision (the camera worker — backend/vision/__init__.py) ---------

# The VLM ollama talks to. Unset: qwen2.5vl:3b (the shipped model — see
# backend/vision/__init__.py's latency comment for why qwen3-vl:8b was dropped).
VLM_MODEL=qwen2.5vl:3b
# NOTE: the vision worker's Ollama host is hardcoded to http://localhost:11434
# (backend/vision/__init__.py) — it does NOT read OLLAMA_URL. Point it
# elsewhere with `python -m vision --ollama <url>`, not an env var.
# YOLO weights file, downloaded by ultralytics on first use if missing. Unset:
# yolo11s.pt.
YOLO_MODEL=yolo11s.pt
# Where `python -m vision` posts observations. Unset: http://localhost:8000
# (matches PUBLIC_BASE_URL's default — set both together if you move the API).
DHYAAN_API=http://localhost:8000
# The worker's --band-key flag still exists and sends an X-Band-Key header;
# the API ignores it (no auth, see app/main.py).

# --- dhyaan/voice (Twilio + Deepgram bridge — imports lazily; tests need none of this) ---
# Full setup: docs/voice-README.md, section B0.

# Twilio (B0.1-B0.4: create account, UPGRADE ~$20, buy a voice number, verify
# all team phones). Unset: any call attempt raises immediately with a clear
# "fill .env" error — nothing silently no-ops.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_E164=+1xxxxxxxxxx

# Deepgram (B0.5-B0.6: get key, run scripts/dg_connect_test.py, expect a
# Welcome frame). Unset: the bridge sends an empty auth token and Deepgram
# rejects the connection.
DEEPGRAM_API_KEY=

# cloudflared tunnel (B0.9): run `cloudflared tunnel --url http://localhost:8000`,
# paste the printed hostname here, and DO NOT restart the tunnel afterwards —
# a restart changes the hostname and silently breaks every call (B10.3).
# Unset: outbound.py raises immediately when it tries to build the TwiML/status
# callback URLs, before placing any call.
PUBLIC_HTTPS=https://xxxx.trycloudflare.com
PUBLIC_WSS=wss://xxxx.trycloudflare.com/twilio/stream

# The Deepgram agent's think provider is OpenAI (gpt-4.1-mini, provider type
# `open_ai`) configured in the Settings message — Deepgram routes it through its
# own managed LLM; no OPENAI_API_KEY is needed or sent in this slice.
