# Copy to .env and fill during hour 0 (see dhyaan/voice/README.md, section B0).
# The voice slice imports lazily — tests run with none of these set.

# Twilio (B0.1–B0.4: create account, UPGRADE ~$20, buy a voice number, verify all team phones)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_E164=+1xxxxxxxxxx

# Deepgram (B0.5–B0.6: get key, run scripts/dg_connect_test.py, expect a Welcome frame)
DEEPGRAM_API_KEY=

# cloudflared tunnel (B0.9): run `cloudflared tunnel --url http://localhost:8000`,
# paste the printed hostname here, and DO NOT restart the tunnel afterwards —
# a restart changes the hostname and silently breaks every call (B10.3).
PUBLIC_HTTPS=https://xxxx.trycloudflare.com
PUBLIC_WSS=wss://xxxx.trycloudflare.com/twilio/stream

# The Deepgram agent's think provider is Anthropic (claude-haiku-4-5) configured in
# the Settings message — Deepgram routes it; no Anthropic key needed in this slice.
